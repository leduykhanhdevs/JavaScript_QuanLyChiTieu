{
  "name": "vi-minh-personal-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Website quản lý chi tiêu cá nhân dùng JavaScript thuần và PostgreSQL",
  "scripts": {
    "start": "node server/local.js",
    "dev": "node --watch server/local.js",
    "desktop": "electron .",
    "db:migrate": "node server/db/migrate.js",
    "db:promote-admin": "node --import dotenv/config server/db/promote-admin.js",
    "preworker:dev": "node scripts/prepare-worker-assets.js",
    "worker:dev": "wrangler dev",
    "preworker:deploy": "node scripts/prepare-worker-assets.js",
    "worker:deploy": "wrangler deploy",
    "preworker:dry-run": "node scripts/prepare-worker-assets.js",
    "worker:dry-run": "wrangler deploy --dry-run --outdir tmp/worker-bundle"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "wrangler": "^4.0.0"
  }
}
